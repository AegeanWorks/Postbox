      "agent": "opencode:postbox",
      "impact_assessment": {
        "why": "A probe showed extend() into a non-empty inbox replaces all existing records, so importing a snapshot silently destroys prior captures.",
        "benefits": "Batch appends and imports preserve existing state; no data loss.",
        "risks": "contract: none, this restores intended behaviour; dependency: none; concurrency: decode and rewrite stay under the existing lock; state: a corrupt inbox still fails before any write.",
