      "agent": "opencode:postbox",
      "impact_assessment": {
        "why": "There is no way to remove one captured request; clear wipes the whole inbox, which is too coarse for a noisy webhook stream.",
        "benefits": "Users can discard a single noisy capture without losing the rest of the evidence.",
        "risks": "contract: new command only; dependency: none; concurrency: delete must hold the same store lock as append and trim; state: a partial delete must not corrupt the JSONL file.",
