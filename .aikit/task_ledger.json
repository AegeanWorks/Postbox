      "task_id": "postbox-clear",
      "phase": "phase 2",
      "phase_num": 2,
      "description": "[1/4] Clear endpoint safety: only POST/DELETE clear, all other methods 405, drain request body",
      "files_affected": [],
      "status": "in_progress",
      "timestamp": 1795067092.0843067,
      "timestamp_str": "2026-11-19 08:44:52",
      "agent": "opencode:postbox",
      "impact_assessment": {
        "why": "A probe showed HEAD /__clear wipes the inbox, defeating the documented prefetch protection, and POST /__clear with a body aborts the client with WinError 10053.",
        "benefits": "Read-only probes can no longer destroy captures, and clients sending a body get a stable response.",
        "risks": "contract: HEAD/OPTIONS/CONNECT/TRACE on clear change from destructive to 405, so README and ADR must follow; dependency: none; concurrency: none; state: an oversized body is drained only up to a bound.",
        "mitigation": "Use an explicit allowed-method set, drain a bounded prefix before answering, and add raw-socket failing-first tests for every method plus a body-bearing POST."
      },
      "plan_digest": "4c180a99d01b892711317aebea25677df12fdb1b8e016d90845c2d504279ab8a",
